{
  "name": "date-holidays-ical",
  "version": "2.2.0-0",
  "description": "Generate ical files from date-holidays data",
  "keywords": [
    "holidays",
    "ical",
    "vcalendar",
    "world"
  ],
  "homepage": "https://github.com/commenthol/date-holidays-ical#readme",
  "bugs": {
    "url": "https://github.com/commenthol/date-holidays-ical/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/commenthol/date-holidays-ical.git"
  },
  "license": "ISC",
  "author": "commenthol <commenthol@gmail.com>",
  "maintainers": [
    "commenthol <commenthol@gmail.com>"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js",
      "require": "./lib/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/index.cjs",
  "module": "./src/index.js",
  "types": "./types/index.d.ts",
  "bin": {
    "holidays-ical": "bin/holidays-ical.cjs"
  },
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "files": [
    "bin",
    "src",
    "lib",
    "types"
  ],
  "scripts": {
    "all": "run-s clean pretty lint types build test",
    "build": "rollup -c",
    "ci": "run-s all",
    "clean": "rimraf lib types coverage .nyc_output",
    "clean:all": "run-s clean clean:node_modules",
    "clean:node_modules": "rimraf node_modules",
    "coverage": "c8 -r text -r html npm run test:ci",
    "lint": "eslint src test bin rollup.config.mjs eslint.config.js",
    "pretty": "prettier -w src test bin rollup.config.mjs eslint.config.js",
    "prepublishOnly": "npm run all",
    "test": "mocha",
    "test:ci": "mocha",
    "types": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "date-holidays": "3.39.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "c8": "^12.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "mocha": "^12.0.3",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "rollup": "^4.68.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=12.0.0"
  }
}
